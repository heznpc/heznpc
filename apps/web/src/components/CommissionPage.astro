---
import brand from '../../../../heznpc.config.mjs';
import SimpleHeroPage from './SimpleHeroPage.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const t = dict.commission;
---

<SimpleHeroPage
  eyebrow={t.eyebrow}
  heading={t.heading}
  body={t.body}
  cta={t.cta}
  href={brand.links.x}
  marker="@"
/>
