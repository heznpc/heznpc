---
interface Props {
  icon?: string | null;
  iconEmoji?: string;
  name: string;
  size: number;
  fontSize: string;
}

const { icon, iconEmoji, name, size, fontSize } = Astro.props;
---

{icon ? (
  <img
    src={icon}
    alt={name}
    class="proj-icon"
    width={size}
    height={size}
    style={`width:${size}px;height:${size}px`}
  />
) : (
  <div
    class="proj-icon"
    style={`width:${size}px;height:${size}px;font-size:${fontSize}`}
  >
    {iconEmoji || ''}
  </div>
)}
