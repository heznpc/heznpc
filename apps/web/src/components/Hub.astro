---
import { base } from '../utils/base';
import type { Dict, Locale } from '../i18n';
import ProjectRow from './ProjectRow.astro';
import { getPortfolioViewModel } from '../utils/portfolio';
import type { PortfolioData, ProjectStatus } from '../utils/types';

import projectsData from '../../projects.json';

interface Props {
  locale: Locale;
  dict: Dict;
}

const { locale, dict } = Astro.props;
const t = dict.home;
const copy = dict.hub;

const data = projectsData as PortfolioData;
const starters = data.starters;
const { areas, hero, caseStudies, frontProof, lowerProof } = getPortfolioViewModel(data);

const introHref = locale === 'en' ? `${base}intro/` : `${base}${locale}/intro/`;

function statusLabel(status: ProjectStatus): string {
  return copy.statusLabels[status];
}
---

<!-- 1. HERO -->
<header class="hero">
  <h1 class="hero-name reveal">heznpc</h1>
  <p class="hero-tagline reveal" data-delay="60">{t.tagline}</p>
  <p class="hero-bio reveal" data-delay="120">{t.bio}</p>
  <a class="hero-watch reveal" data-delay="200" href={introHref}>
    <span>▸</span> {t.watchIntro}
  </a>
</header>

<!-- 2. THESIS -->
<section style="padding: 24px 0 48px">
  <div class="container reveal">
    <p class="thesis">{t.thesis}</p>
  </div>
</section>

<!-- 3. SELECTED PROOF -->
{hero && (
  <section style="padding: 32px 0 56px">
    <div class="container" data-category={hero.category}>
      <header class="chapter-header">
        <div class="chapter-num">§ 01</div>
        <div class="chapter-title">{copy.selectedProof}</div>
        <div class="chapter-count">{copy.proofCount(frontProof.length)}</div>
      </header>
      <p class="section-caption reveal">{copy.proofCaption}</p>

      <article class="editorial-spread proof-hero reveal" data-delay="40">
        <div>
          <div class="editorial-spread-eyebrow">{statusLabel(hero.status)} · {hero.tags.slice(0, 2).join(' · ')}</div>
          <a href={hero.url} target="_blank" rel="noopener" style="text-decoration:none;color:inherit">
            <h2 class="editorial-spread-title">{hero.name}</h2>
          </a>
          <p class="editorial-spread-body">{hero.description}</p>
        </div>
        <aside class="editorial-spread-aside proof-aside">
          {hero.evidence && (
            <div class="proof-note">
              <span>{copy.evidence}</span>
              <p>{hero.evidence}</p>
            </div>
          )}
          {hero.constraint && (
            <div class="proof-note">
              <span>{copy.constraint}</span>
              <p>{hero.constraint}</p>
            </div>
          )}
          <a href={hero.url} target="_blank" rel="noopener" class="editorial-spread-link">
            {copy.openRepo} <span>→</span>
          </a>
        </aside>
      </article>

      {caseStudies.length > 0 && (
        <ul class="editorial-list proof-list">
          {caseStudies.map((p, i) => (
            <ProjectRow
              project={p}
              index={i}
              statusLabel={statusLabel(p.status)}
              evidenceLabel={copy.evidence}
              constraintLabel={copy.constraint}
              showProof
            />
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<!-- 4. FOCUS AREAS -->
<section style="padding: 24px 0 56px">
  <div class="container">
    <header class="chapter-header">
      <div class="chapter-num">§ 02</div>
      <div class="chapter-title">{copy.focusAreas}</div>
      <div class="chapter-count">{copy.areaCount(areas.length)}</div>
    </header>

    <div class="area-list">
      {areas.map((area, i) => {
        const linked = area.projects;
        return (
          <article class="area-block reveal" data-delay={String(Math.min(i * 35, 210))}>
            <div class="program-header">
              <span class="program-num">A{String(i + 1).padStart(2, '0')}</span>
              <span class="program-label">{area.label}</span>
              <span class="program-count">{linked.length || copy.noRepoClaim}</span>
            </div>
            <p class="program-blurb">{area.summary}</p>
            <div class="area-notes">
              <p><span>{copy.now}</span>{area.current}</p>
              <p><span>{copy.frontier}</span>{area.frontier}</p>
            </div>
            {linked.length > 0 && (
              <div class="area-proof-strip" aria-label={copy.related}>
                {linked.map((p) => (
                  <a href={p.url} target="_blank" rel="noopener">
                    {p.iconEmoji && <span>{p.iconEmoji}</span>}
                    <strong>{p.name}</strong>
                    <em>{statusLabel(p.status)}</em>
                  </a>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- 5. LAB / ARCHIVE -->
{lowerProof.length > 0 && (
  <section style="padding: 32px 0 56px">
    <div class="container">
      <div class="reveal">
        <button class="accordion" id="labToggle" data-accordion aria-expanded="false" aria-controls="labContent">
          <div>
            <p class="section-label" style="margin-bottom:4px">{copy.labArchive}</p>
            <p class="accordion-caption">{copy.labCaption}</p>
          </div>
          <svg class="accordion-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="accordion-content" id="labContent" role="region" aria-labelledby="labToggle">
          <div>
            <ul class="editorial-list lab-list">
              {lowerProof.map((p, i) => (
                <ProjectRow project={p} index={i} statusLabel={statusLabel(p.status)} />
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<!-- 6. STARTERS -->
<section style="padding: 32px 0 80px">
  <div class="container">
    <div class="reveal">
      <button class="accordion" id="starterToggle" data-accordion aria-expanded="false" aria-controls="starterContent">
        <div>
          <p class="section-label" style="margin-bottom:4px">{t.sectionStarters}</p>
          <p class="accordion-caption">{t.starterCaption.replace('{count}', String(starters.length))}</p>
        </div>
        <svg class="accordion-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
      <div class="accordion-content" id="starterContent" role="region" aria-labelledby="starterToggle">
        <div>
          <div class="starter-grid">
            {starters.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" class="starter-item">
                <span class="starter-name">{s.name}</span>
                <span class="starter-deploy">{s.deployTo}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-accordion]').forEach(function (toggle) {
      var id = toggle.getAttribute('aria-controls');
      var content = id ? document.getElementById(id) : null;
      if (!content) return;
      var arrow = toggle.querySelector('.accordion-arrow');
      toggle.addEventListener('click', function () {
        var open = content.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (arrow) arrow.style.transform = open ? 'rotate(180deg)' : '';
      });
    });
  })();
</script>
