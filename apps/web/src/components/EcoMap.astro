---
import type { BandKey, Project } from '../utils/types';

interface Props {
  bands: Record<BandKey, Project[]>;
}

const { bands } = Astro.props;

const HUES: Record<BandKey, string> = {
  brand5:     '#c9b3f6',
  programs:   '#8ab4ff',
  supporting: '#9de3c4',
  lab:        '#f6b3c8',
  archive:    'rgba(239, 230, 210, .55)',
};

const LAYERS: { key: BandKey; label: string }[] = [
  { key: 'brand5',     label: 'Brand 5' },
  { key: 'programs',   label: 'Programs' },
  { key: 'supporting', label: 'Supporting' },
  { key: 'lab',        label: 'Lab' },
  { key: 'archive',    label: 'Archive' },
];

const rowH = 56;
const gap = 10;
const padV = 16;
const totalH = LAYERS.length * rowH + (LAYERS.length - 1) * gap + padV * 2;
const w = 680;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${w} ${totalH}`}
  width="100%"
  style={`max-width:${w}px;display:block;margin:0 auto`}
  role="img"
  aria-label="Ecosystem map: Brand 5, Programs, Supporting, Lab, Archive"
>
  {LAYERS.map((layer, i) => {
    const color = HUES[layer.key];
    const y = padV + i * (rowH + gap);
    const items = bands[layer.key] || [];
    const names = items.map((p) => p.name).join('  ·  ');
    const count = `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
    return (
      <>
        <rect
          x="6" y={y}
          width={w - 12} height={rowH}
          rx="14" ry="14"
          fill="transparent"
          stroke={color}
          stroke-width="1"
          stroke-opacity=".4"
        />
        <text
          x="22" y={y + 21}
          fill={color}
          font-size="10"
          font-family="JetBrains Mono, monospace"
          letter-spacing="2.2"
        >{layer.label.toUpperCase()} · {count}</text>
        <text
          x="22" y={y + 42}
          fill="rgba(244,238,227,.72)"
          font-size="13"
          font-family="Fraunces, Georgia, serif"
        >{names}</text>
      </>
    );
  })}
</svg>
