---
import type { Project } from '../utils/types';

interface Props {
  categories: Record<string, Project[]>;
}

const { categories } = Astro.props;

const HUES: Record<string, string> = {
  research:   '#8ab4ff',
  tools:      '#9de3c4',
  products:   '#f6b3c8',
  foundation: '#c9b3f6',
};

const layers = [
  { key: 'research',   label: 'Research' },
  { key: 'tools',      label: 'Tools' },
  { key: 'products',   label: 'Products' },
  { key: 'foundation', label: 'Foundation' },
];

const rowH = 58;
const gap = 10;
const padV = 16;
const totalH = layers.length * rowH + (layers.length - 1) * gap + padV * 2;
const w = 680;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${w} ${totalH}`}
  width="100%"
  style={`max-width:${w}px;display:block;margin:0 auto`}
  role="img"
  aria-label="Ecosystem map: Research, Tools, Products, Foundation"
>
  {layers.map((layer, i) => {
    const color = HUES[layer.key];
    const y = padV + i * (rowH + gap);
    const names = (categories[layer.key] || []).map((p) => p.name).join('  ·  ');
    return (
      <>
        <rect
          x="6" y={y}
          width={w - 12} height={rowH}
          rx="14" ry="14"
          fill="transparent"
          stroke={color}
          stroke-width="1"
          stroke-opacity=".35"
        />
        <text
          x="22" y={y + 21}
          fill={color}
          font-size="10"
          font-family="JetBrains Mono, monospace"
          letter-spacing="2.2"
        >{layer.label.toUpperCase()}</text>
        <text
          x="22" y={y + 42}
          fill="rgba(244,238,227,.72)"
          font-size="13"
          font-family="Instrument Serif, Georgia, serif"
        >{names}</text>
      </>
    );
  })}
</svg>
