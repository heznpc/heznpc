---
interface Props {
  class?: string;
  extraAttrs?: Record<string, string>;
  hue?: 'foundation' | 'products' | 'tools' | 'research';
}

const { class: className, extraAttrs = {}, hue } = Astro.props;
const classes = ['card', hue ? 'has-hue' : null, className].filter(Boolean).join(' ');
const style = hue ? `--hue: var(--c-${hue})` : undefined;
---

<div class={classes} style={style} {...extraAttrs}>
  <slot />
</div>
