---
import '../styles/global.css';
import { base } from '../utils/base';
import brand from '../../../../heznpc.config.mjs';
import LangSwitch from '../components/LangSwitch.astro';
import { getDict, getLocale, localizePath } from '../i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  footerExtra?: string;
  showNav?: boolean;
}

const { title, description, ogImage, footerExtra, showNav = true } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getDict(locale);
const desc = description || t.meta.description;
const image = ogImage || 'https://github.com/heznpc.png';

const homeHref = locale === 'en' ? base : `${base}${locale}/`;
const galleryHref = `${base.slice(0, -1)}${localizePath('/gallery/', locale)}`;
const commissionHref = `${base.slice(0, -1)}${localizePath('/commission/', locale)}`;
---

<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#07080c" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:image" content={image} />
  <link rel="alternate" hreflang="en" href={`https://heznpc.github.io${localizePath(Astro.url.pathname, 'en')}`} />
  <link rel="alternate" hreflang="ko" href={`https://heznpc.github.io${localizePath(Astro.url.pathname, 'ko')}`} />
  <link rel="alternate" hreflang="x-default" href={`https://heznpc.github.io${localizePath(Astro.url.pathname, 'en')}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  {showNav && (
    <nav class="nav">
      <div class="nav-inner">
        <a href={homeHref} class="nav-brand">heznpc</a>
        <div class="nav-links">
          <a href={galleryHref} class="nav-link">{t.nav.gallery}</a>
          <a href={commissionHref} class="nav-link">{t.nav.commission}</a>
          <a href={brand.links.github} target="_blank" rel="noopener" class="nav-link">{t.nav.github}</a>
          <LangSwitch />
        </div>
      </div>
    </nav>
  )}

  <slot />

  <footer class="footer">
    <a href={brand.links.github} target="_blank" rel="noopener">heznpc</a>
    {footerExtra && <p class="footer-extra" set:html={footerExtra} />}
  </footer>

  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('visible'); });
        return;
      }
      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              var d = parseInt(e.target.dataset.delay || 0);
              setTimeout(function () { e.target.classList.add('visible'); }, d);
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
    })();
  </script>
</body>
</html>
