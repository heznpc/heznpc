---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hub from '../components/Hub.astro';
import projectsData from '../../projects.json';
import { getDict } from '../i18n';
import { getHomeStats } from '../utils/portfolio';
import type { PortfolioData } from '../utils/types';

const locale = 'en' as const;
const dict = getDict(locale);
const data = projectsData as PortfolioData;
const meta = data.meta;
const footerExtra = dict.home.footerStats(getHomeStats(data));
---

<BaseLayout title={`${meta.name} ${dict.home.titleSuffix}`} footerExtra={footerExtra}>
  <Hub locale={locale} dict={dict} />
</BaseLayout>
