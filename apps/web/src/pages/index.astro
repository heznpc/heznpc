---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
import EcoMap from '../components/EcoMap.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import ProjectTags from '../components/ProjectTags.astro';
import { groupByCategory, type Project, type Starter } from '../utils/types';
import { base } from '../utils/base';

import projectsData from '../../projects.json';

const meta = projectsData.meta;
const projects = projectsData.projects as Project[];
const starters = projectsData.starters as Starter[];

const flagships = projects.filter((p) => p.tier === 1);
const catalogProjects = projects.filter((p) => p.tier !== 1);

const airmcp = flagships.find((p) => p.id === 'airmcp');
const otherFlagships = flagships.filter((p) => p.id !== 'airmcp');

const categories = groupByCategory(projects);

const footerExtra = `${projects.length} projects &middot; ${categories.research.length} research &middot; ${starters.length} templates`;
---

<BaseLayout title={`${meta.name} — AI / Software Engineer`} footerExtra={footerExtra}>

  <!-- 1. HERO -->
  <header class="hero">
    <div class="hero-cells" aria-hidden="true">
      <div class="hero-cell hero-cell-a"></div>
      <div class="hero-cell hero-cell-b"></div>
      <div class="hero-cell hero-cell-c"></div>
    </div>
    <h1 class="hero-name reveal">{meta.name}</h1>
    <p class="hero-tagline reveal" data-delay="60">{meta.tagline}</p>
    <p class="hero-bio reveal" data-delay="120">{meta.bio}</p>
    <a class="hero-watch reveal" data-delay="200" href={`${base}intro/`}>
      <span>▸</span> Watch intro
    </a>
  </header>

  <!-- 2. THESIS -->
  <section style="padding: 24px 0 48px">
    <div class="container reveal">
      <p class="thesis">{meta.thesis}</p>
    </div>
  </section>

  <!-- 3. FLAGSHIP -->
  <section style="padding: 48px 0">
    <div class="container">
      <p class="section-label reveal">Flagship</p>

      {airmcp && (
        <a href={airmcp.url} target="_blank" rel="noopener" class="card-link">
          <GlassCard class="flagship-large reveal" hue={airmcp.category as any}>
            <ProjectIcon
              icon={airmcp.icon}
              iconEmoji={airmcp.iconEmoji}
              name={airmcp.name}
              size={64}
              fontSize="2rem"
            />
            <div style="flex:1; min-width:200px">
              <div class="card-title">{airmcp.name}</div>
              <p class="card-desc">{airmcp.description}</p>
              <ProjectTags tags={airmcp.tags} />
            </div>
          </GlassCard>
        </a>
      )}

      {otherFlagships.length > 0 && (
        <div class="flagship-grid">
          {otherFlagships.map((p, i) => (
            <a href={p.url} target="_blank" rel="noopener" class="card-link">
              <GlassCard class="flagship-medium reveal" hue={p.category as any} extraAttrs={{ 'data-delay': String(60 + i * 40) }}>
                <ProjectIcon icon={p.icon} iconEmoji={p.iconEmoji} name={p.name} size={48} fontSize="1.6rem" />
                <div style="flex:1; min-width:0">
                  <div class="card-title" style="font-size:1.15rem">{p.name}</div>
                  <p class="card-desc">{p.description}</p>
                  <ProjectTags tags={p.tags} />
                </div>
              </GlassCard>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 4. ECOSYSTEM MAP -->
  <section style="padding: 48px 0">
    <div class="container">
      <p class="section-label reveal">Ecosystem</p>
      <div class="reveal" data-delay="40">
        <EcoMap categories={categories} />
      </div>
    </div>
  </section>

  <!-- 5. CATALOG -->
  <section style="padding: 48px 0">
    <div class="container">
      <p class="section-label reveal">Catalog</p>
      <div class="tabs reveal" role="tablist" aria-label="Filter projects by category">
        <button class="tab active" role="tab" aria-selected="true" data-filter="all">All</button>
        <button class="tab" role="tab" aria-selected="false" data-filter="foundation">Foundation</button>
        <button class="tab" role="tab" aria-selected="false" data-filter="products">Products</button>
        <button class="tab" role="tab" aria-selected="false" data-filter="tools">Tools</button>
        <button class="tab" role="tab" aria-selected="false" data-filter="research">Research</button>
      </div>
      <div class="catalog-grid" role="tabpanel">
        {catalogProjects.map((p, i) => (
          <a href={p.url} target="_blank" rel="noopener" class="card-link">
            <GlassCard
              class="catalog-card reveal"
              hue={p.category as any}
              extraAttrs={{
                'data-delay': String(Math.min(i * 28, 180)),
                'data-category': p.category,
              }}
            >
              <ProjectIcon icon={p.icon} iconEmoji={p.iconEmoji} name={p.name} size={36} fontSize="1.2rem" />
              <div style="flex:1; min-width:0">
                <div class="card-title" style="font-size:1.05rem">{p.name}</div>
                <p class="card-desc" style="font-size:.85rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden">{p.description}</p>
                <ProjectTags tags={p.tags} />
              </div>
            </GlassCard>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. STARTERS -->
  <section style="padding: 48px 0 80px">
    <div class="container">
      <div class="reveal">
        <button class="accordion" id="starterToggle" aria-expanded="false" aria-controls="starterContent">
          <div>
            <p class="section-label" style="margin-bottom:4px">Starter Series</p>
            <p style="font-size:.8rem; color:var(--ink-ghost); font-family:var(--font-mono); letter-spacing:.04em">Clone → Push → Deployed · {starters.length} CI/CD templates</p>
          </div>
          <svg class="accordion-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="accordion-content" id="starterContent" role="region" aria-labelledby="starterToggle">
          <div>
            <div class="starter-grid">
              {starters.map((s) => (
                <a href={`https://github.com/${s.repo}`} target="_blank" rel="noopener" class="starter-item">
                  <span class="starter-name">{s.name}</span>
                  <span class="starter-deploy">{s.deployTo}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Tab filtering
    (function () {
      var tabs = document.querySelectorAll('.tab');
      var cards = document.querySelectorAll('.catalog-card');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          var filter = tab.dataset.filter;
          cards.forEach(function (card) {
            var link = card.closest('.card-link');
            if (!link) return;
            link.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
          });
        });
      });
    })();

    // Accordion
    (function () {
      var toggle = document.getElementById('starterToggle');
      var content = document.getElementById('starterContent');
      if (!toggle || !content) return;
      var arrow = toggle.querySelector('.accordion-arrow');
      toggle.addEventListener('click', function () {
        var open = content.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        arrow.style.transform = open ? 'rotate(180deg)' : '';
      });
    })();
  </script>
</BaseLayout>
