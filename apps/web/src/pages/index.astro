---
import BaseLayout from '../layouts/BaseLayout.astro';
import EcoMap from '../components/EcoMap.astro';
import { groupByCategory, type Project, type Starter } from '../utils/types';
import { base } from '../utils/base';

import projectsData from '../../projects.json';

const meta = projectsData.meta;
const projects = projectsData.projects as Project[];
const starters = projectsData.starters as Starter[];

const airmcp = projects.find((p) => p.id === 'airmcp');
const catalogProjects = projects.filter((p) => p.id !== 'airmcp');
const categories = groupByCategory(projects);

const chapterOrder: Array<keyof typeof categories> = ['foundation', 'products', 'tools', 'research'];
const chapters = chapterOrder.map((key, i) => ({
  key: key as string,
  num: String(i + 1).padStart(2, '0'),
  label: (key as string).charAt(0).toUpperCase() + (key as string).slice(1),
  items: (categories[key] ?? []).filter((p) => p.id !== 'airmcp'),
  total: (categories[key] ?? []).length,
})).filter((c) => c.items.length > 0);

let runningIdx = 0;
const numberedChapters = chapters.map((c) => ({
  ...c,
  items: c.items.map((p) => {
    runningIdx += 1;
    return { ...p, n: String(runningIdx).padStart(2, '0') };
  }),
}));

const footerExtra = `${projects.length} projects &middot; ${categories.research.length} research &middot; ${starters.length} templates`;
---

<BaseLayout title={`${meta.name} — AI / Software Engineer`} footerExtra={footerExtra}>

  <!-- 1. HERO -->
  <header class="hero">
    <div class="hero-cells" aria-hidden="true">
      <div class="hero-cell hero-cell-a"></div>
      <div class="hero-cell hero-cell-b"></div>
      <div class="hero-cell hero-cell-c"></div>
    </div>
    <h1 class="hero-name reveal">{meta.name}</h1>
    <p class="hero-tagline reveal" data-delay="60">{meta.tagline}</p>
    <p class="hero-bio reveal" data-delay="120">{meta.bio}</p>
    <a class="hero-watch reveal" data-delay="200" href={`${base}intro/`}>
      <span>▸</span> Watch intro
    </a>
  </header>

  <!-- 2. THESIS -->
  <section style="padding: 24px 0 48px">
    <div class="container reveal">
      <p class="thesis">{meta.thesis}</p>
    </div>
  </section>

  <!-- 3. FLAGSHIP — editorial spread -->
  {airmcp && (
    <section style="padding: 32px 0 56px">
      <div class="container" data-category={airmcp.category}>
        <article class="editorial-spread reveal">
          <div>
            <div class="editorial-spread-eyebrow">Flagship · {airmcp.category}</div>
            <a href={airmcp.url} target="_blank" rel="noopener" style="text-decoration:none;color:inherit">
              <h2 class="editorial-spread-title">{airmcp.name}</h2>
            </a>
            <p class="editorial-spread-body">{airmcp.description}</p>
          </div>
          <aside class="editorial-spread-aside">
            <div class="editorial-spread-aside-row">
              <span class="editorial-spread-meta">Tags</span>
              <span class="editorial-spread-meta-value">{airmcp.tags.slice(0, 3).join(' · ')}</span>
            </div>
            <div class="editorial-spread-aside-row">
              <span class="editorial-spread-meta">Status</span>
              <span class="editorial-spread-meta-value">{airmcp.status}</span>
            </div>
            <a href={airmcp.url} target="_blank" rel="noopener" class="editorial-spread-link">
              Read on GitHub <span>→</span>
            </a>
          </aside>
        </article>
      </div>
    </section>
  )}

  <!-- 4. ECOSYSTEM MAP -->
  <section style="padding: 32px 0 48px">
    <div class="container">
      <p class="section-label reveal">Ecosystem</p>
      <div class="reveal" data-delay="40">
        <EcoMap categories={categories} />
      </div>
    </div>
  </section>

  <!-- 5. CATALOG — chaptered editorial list -->
  <section style="padding: 24px 0 64px">
    <div class="container">
      {numberedChapters.map((chapter, gi) => (
        <section class="reveal" data-delay={String(gi * 60)} style="margin-top: 48px" data-category={chapter.key}>
          <header class="chapter-header">
            <div class="chapter-num">§ {chapter.num}</div>
            <div class="chapter-title">{chapter.label}</div>
            <div class="chapter-count">{chapter.total} works</div>
          </header>
          <ul class="editorial-list">
            {chapter.items.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener" class="editorial-row" data-category={p.category}>
                  <div class="editorial-index">{p.n}</div>
                  <div class="editorial-content">
                    <div class="editorial-name">
                      {p.iconEmoji && <span class="editorial-name-emoji">{p.iconEmoji}</span>}
                      <span>{p.name}</span>
                    </div>
                    {p.description && <div class="editorial-desc">{p.description}</div>}
                    {p.tags.length > 0 && (
                      <div class="editorial-tags">
                        {p.tags.slice(0, 4).map((t) => <span class="editorial-tag">{t}</span>)}
                      </div>
                    )}
                  </div>
                  <div class="editorial-meta">
                    <span>{p.status}</span>
                    <span class="editorial-arrow">→</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <!-- 6. STARTERS -->
  <section style="padding: 48px 0 80px">
    <div class="container">
      <div class="reveal">
        <button class="accordion" id="starterToggle" aria-expanded="false" aria-controls="starterContent">
          <div>
            <p class="section-label" style="margin-bottom:4px">Starter Series</p>
            <p style="font-size:.8rem; color:var(--ink-ghost); font-family:var(--font-mono); letter-spacing:.04em">Clone → Push → Deployed · {starters.length} CI/CD templates</p>
          </div>
          <svg class="accordion-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="accordion-content" id="starterContent" role="region" aria-labelledby="starterToggle">
          <div>
            <div class="starter-grid">
              {starters.map((s) => (
                <a href={`https://github.com/${s.repo}`} target="_blank" rel="noopener" class="starter-item">
                  <span class="starter-name">{s.name}</span>
                  <span class="starter-deploy">{s.deployTo}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var toggle = document.getElementById('starterToggle');
      var content = document.getElementById('starterContent');
      if (!toggle || !content) return;
      var arrow = toggle.querySelector('.accordion-arrow');
      toggle.addEventListener('click', function () {
        var open = content.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        arrow.style.transform = open ? 'rotate(180deg)' : '';
      });
    })();
  </script>
</BaseLayout>
