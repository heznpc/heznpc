---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hub from '../../components/Hub.astro';
import projectsData from '../../../projects.json';
import { getDict } from '../../i18n';

const locale = 'ko' as const;
const dict = getDict(locale);
const meta = projectsData.meta;
const projects = projectsData.projects.length;
const programs = new Set(projectsData.projects.filter((p: any) => p.program != null && p.program <= 5).map((p: any) => p.program)).size;
const supporting = projectsData.projects.filter((p: any) => p.category === 'supporting').length;
const lab = projectsData.projects.filter((p: any) => p.category === 'lab').length;
const templates = projectsData.starters.length;
const footerExtra = dict.home.footerStats({ projects, programs, supporting, lab, templates });
---

<BaseLayout title={`${meta.name} ${dict.home.titleSuffix}`} footerExtra={footerExtra}>
  <Hub locale={locale} dict={dict} />
</BaseLayout>
