---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { base } from '../../utils/base';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — heznpc`} description={post.data.description}>

  <article class="blog-post">
    <div class="blog-post-header">
      <a href={`${base}blog/`} class="back-link reveal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        Back
      </a>
      <h1 class="reveal">{post.data.title}</h1>
      <div class="blog-post-meta reveal" data-delay="40">
        <span>{formatDate(new Date(post.data.date), 'long')}</span>
        {post.data.tags.length > 0 && (
          <span style="margin-left:14px">
            {post.data.tags.map((tag: string) => (
              <span class="tag" style="margin-left:4px">{tag}</span>
            ))}
          </span>
        )}
      </div>
    </div>

    <div class="blog-post-body reveal" data-delay="80">
      <Content />
    </div>

    <div style="padding: 56px 0 0">
      <a href={`${base}blog/`} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        Back
      </a>
    </div>
  </article>
</BaseLayout>
