---
import { base } from '../utils/base';
const title = 'heznpc — Intro';
const description = 'An ecosystem, in three views.';
---
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#07080c" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
  @property --tx { syntax: '<length>'; inherits: false; initial-value: 0px; }
  @property --ty { syntax: '<length>'; inherits: false; initial-value: 0px; }
  @property --s  { syntax: '<number>'; inherits: false; initial-value: 0; }

  :root {
    --bg: #07080c;
    --ink: #f4eee3;
    --ink-dim: rgba(244,238,227,.5);
    --c-research:   #8ab4ff;
    --c-works:      #f6b3c8;
    --c-writings:   #efd38a;
    --c-illust:     #9de3c4;
    --c-foundation: #c9b3f6;
    --c-seed:       #ffffff;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; background: var(--bg); color: var(--ink); font-family: 'Instrument Serif', serif; overflow: hidden; }
  body { position: fixed; inset: 0; }

  /* film grain overlay */
  body::after {
    content: '';
    position: fixed; inset: 0;
    pointer-events: none;
    z-index: 9999;
    opacity: .28;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.5'/></svg>");
  }

  /* vignette */
  body::before {
    content: '';
    position: fixed; inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,.55) 100%);
  }

  .stage {
    position: fixed; inset: 0;
    display: grid; place-items: center;
    z-index: 2;
  }
  .world {
    position: relative;
    width: min(960px, 92vw);
    aspect-ratio: 16/10;
  }

  /* ========= CELLS ========= */
  .cell {
    position: absolute;
    left: 50%; top: 50%;
    width: 96px; height: 96px;
    border-radius: 50%;
    --tx: 0px; --ty: 0px; --s: 0;
    transform: translate(-50%, -50%) translate(var(--tx), var(--ty)) scale(var(--s));
    background:
      radial-gradient(circle at 35% 32%, rgba(255,255,255,.95), rgba(255,255,255,.08) 52%, transparent 72%),
      radial-gradient(circle at 50% 50%, var(--hue, #fff), transparent 65%);
    box-shadow: 0 0 48px 6px color-mix(in oklab, var(--hue, #fff) 45%, transparent);
    mix-blend-mode: screen;
    will-change: transform, opacity, filter;
  }

  /* seed cell: birth + heartbeat + fade before name appears */
  .cell.seed {
    --hue: var(--c-seed);
    animation:
      seedBirth 1.4s cubic-bezier(.2,.9,.3,1.4) .3s forwards,
      seedPulse 2.2s ease-in-out 1.7s 2,
      seedFade 1.2s ease-out 5.5s forwards;
  }
  @keyframes seedBirth {
    0%   { --s: 0;    opacity: 0; }
    60%  { --s: 1.18; opacity: 1; }
    100% { --s: 1;    opacity: 1; }
  }
  @keyframes seedPulse {
    0%,100% { --s: 1; filter: brightness(1); }
    25%     { --s: 1.22; filter: brightness(1.25); }
    40%     { --s: .92; filter: brightness(.95); }
    60%     { --s: 1.12; filter: brightness(1.15); }
  }
  @keyframes seedFade {
    to { --s: 2.2; opacity: 0; filter: blur(12px) brightness(1.4); }
  }

  /* division cells: spawn at center then drift to --fx,--fy */
  .cell.d {
    animation:
      divide 1.6s cubic-bezier(.2,.7,.3,1.05) var(--delay, 4s) forwards,
      breathe 4.8s ease-in-out calc(var(--delay, 4s) + 2.2s) infinite;
  }
  @keyframes divide {
    0%   { --s: 0;   --tx: 0px; --ty: 0px; opacity: 0; }
    25%  { --s: 1.1; opacity: 1; }
    100% { --s: var(--fs, .85); --tx: var(--fx, 0px); --ty: var(--fy, 0px); opacity: 1; }
  }
  @keyframes breathe {
    0%,100% { filter: brightness(1); }
    50%     { filter: brightness(1.25); }
  }

  /* ========= NAME ========= */
  .name {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(56px, 9vw, 108px);
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--ink);
    pointer-events: none;
    display: flex;
    z-index: 3;
  }
  .name span {
    display: inline-block;
    opacity: 0;
    transform: translateY(28px) scale(.88);
    filter: blur(14px);
    animation: nameIn 1s cubic-bezier(.2,.8,.3,1.1) forwards;
  }
  @keyframes nameIn {
    to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
  .name span:nth-child(1){ animation-delay: 6.2s; }
  .name span:nth-child(2){ animation-delay: 6.35s; }
  .name span:nth-child(3){ animation-delay: 6.5s; }
  .name span:nth-child(4){ animation-delay: 6.65s; }
  .name span:nth-child(5){ animation-delay: 6.8s; }
  .name span:nth-child(6){ animation-delay: 6.95s; }

  /* ========= TAGLINE ========= */
  .tagline {
    position: absolute;
    left: 50%;
    top: calc(50% + clamp(50px, 6.5vw, 80px));
    transform: translate(-50%, 0);
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(10px, 1.1vw, 13px);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-dim);
    opacity: 0;
    white-space: nowrap;
    animation: fadeIn 1.2s ease-out 8.6s forwards;
    z-index: 3;
  }
  @keyframes fadeIn { to { opacity: 1; } }

  /* ========= CHROME ========= */
  .enter {
    position: fixed;
    left: 50%; bottom: clamp(28px, 5vh, 56px);
    transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 10px;
    padding: 13px 24px;
    background: transparent;
    color: var(--ink);
    border: 1px solid rgba(244,238,227,.22);
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: .22em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0;
    transition: background .3s ease, border-color .3s ease, transform .3s ease;
    animation: fadeIn 1.2s ease-out 10.2s forwards;
    z-index: 10;
    backdrop-filter: blur(4px);
  }
  .enter:hover {
    background: rgba(244,238,227,.08);
    border-color: rgba(244,238,227,.5);
    transform: translateX(-50%) translateY(-2px);
  }
  .enter .arrow { transition: transform .3s ease; display: inline-block; }
  .enter:hover .arrow { transform: translateX(5px); }

  .skip {
    position: fixed; top: 20px; right: 22px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 999px;
    opacity: .55;
    transition: opacity .2s ease, background .2s ease;
    z-index: 10;
  }
  .skip:hover { opacity: 1; background: rgba(244,238,227,.06); }

  /* reduced motion: show final state immediately */
  @media (prefers-reduced-motion: reduce) {
    .cell.seed { animation: none; --s: 0; opacity: 0; }
    .cell.d {
      animation: none;
      --s: var(--fs, .85);
      --tx: var(--fx, 0px);
      --ty: var(--fy, 0px);
      opacity: 1;
    }
    .name span { animation: none; opacity: 1; transform: translate(0) scale(1); filter: none; }
    .tagline, .enter { animation: none; opacity: 1; }
  }

  @media (max-width: 640px) {
    .cell { width: 70px; height: 70px; }
  }

  /* fast-forward: click or key press snaps to final frame */
  body.done .cell.seed { animation: none; --s: 0; opacity: 0; }
  body.done .cell.d {
    animation: breathe 4.8s ease-in-out infinite;
    --s: var(--fs, .85);
    --tx: var(--fx, 0px);
    --ty: var(--fy, 0px);
    opacity: 1;
  }
  body.done .name span { animation: none; opacity: 1; transform: translate(0) scale(1); filter: none; }
  body.done .tagline,
  body.done .enter { animation: none; opacity: 1; }
</style>
</head>
<body>
<div class="stage">
  <div class="world" aria-hidden="true">
    <div class="cell seed"></div>

    <div class="cell d" style="--hue:var(--c-research);   --fx:-260px; --fy:-120px; --delay:4.0s; --fs:.9"></div>
    <div class="cell d" style="--hue:var(--c-works);      --fx: 280px; --fy:-140px; --delay:4.15s; --fs:.85"></div>
    <div class="cell d" style="--hue:var(--c-writings);   --fx:-320px; --fy:  70px; --delay:4.3s; --fs:.8"></div>
    <div class="cell d" style="--hue:var(--c-illust);     --fx: 340px; --fy:  90px; --delay:4.45s; --fs:.88"></div>
    <div class="cell d" style="--hue:var(--c-foundation);--fx:-160px; --fy: 200px; --delay:4.6s; --fs:.78"></div>
    <div class="cell d" style="--hue:var(--c-research);   --fx: 200px; --fy: 220px; --delay:4.75s; --fs:.82"></div>
    <div class="cell d" style="--hue:var(--c-works);      --fx: -60px; --fy:-240px; --delay:4.9s; --fs:.72"></div>
    <div class="cell d" style="--hue:var(--c-illust);     --fx: 100px; --fy:-260px; --delay:5.05s; --fs:.76"></div>

    <h1 class="name" aria-label="heznpc">
      <span>h</span><span>e</span><span>z</span><span>n</span><span>p</span><span>c</span>
    </h1>
    <p class="tagline">Building the ecosystem AI lives in</p>
  </div>
</div>

<a href={base} class="skip">Skip ›</a>
<a href={base} class="enter">Enter <span class="arrow">→</span></a>

<script is:inline>
  (function(){
    var body = document.body;
    var ff = function(e){
      if (body.classList.contains('done')) return;
      if (e.target && (e.target.closest('a.enter') || e.target.closest('a.skip'))) return;
      body.classList.add('done');
    };
    window.addEventListener('click', ff, { passive: true });
    window.addEventListener('keydown', function(e){
      if (e.key === ' ' || e.key === 'Enter' || e.key === 'Escape') ff(e);
    });
  })();
</script>
</body>
</html>
