---
import brand from '../../../../heznpc.config.mjs';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const webUrl = brand.links.github; // TODO: replace with web landing URL when available
---
<header class="header">
  <a href="/" class="header-brand">{brand.name}</a>
  <div class="header-right">
    <nav class="header-nav">
      <a href="/" class:list={[{ active: currentPath === '/' }]}>갤러리</a>
      <a href="/commission" class:list={[{ active: currentPath === '/commission' }]}>커미션</a>
      <a class="header-link" href={webUrl} target="_blank" rel="noopener">{brand.name}</a>
    </nav>
    <button class="theme-btn" id="themeToggle" aria-label="Toggle theme"></button>
  </div>
</header>
