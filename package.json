{
  "name": "heznpc",
  "version": "2.0.0",
  "private": true,
  "description": "heznpc — personal landing site",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w @heznpc/web run dev",
    "dev:web": "npm -w @heznpc/web run dev",
    "audit": "npm audit --audit-level=high",
    "pack:check": "npm pack --dry-run --json | node scripts/check-pack.mjs",
    "check": "npm run audit && npm -w @heznpc/web run check && npm run pack:check && npm run build:web",
    "build": "npm -w @heznpc/web run build",
    "build:web": "npm -w @heznpc/web run build"
  }
}
